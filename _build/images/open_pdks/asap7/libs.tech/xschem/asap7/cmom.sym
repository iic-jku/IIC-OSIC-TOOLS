*
* Woven MOM capacitor on M<bot> to M<top>, model cmom_m<bot>m<top> with
* bot 1 to 6 and top bot+1 to 7, footprint w (x) by l (y).
* An IIC-OSIC-TOOLS addition, ASAP7 defines no passive devices.
}
G {}
K {type=capacitor
format="@spiceprefix@name @pinlist @model w=@w l=@l m=@m"
lvs_format="@spiceprefix@name @pinlist @model w=@w l=@l m=@m"
spectre_format="@spiceprefix@name ( @pinlist ) @model w=@w l=@l m=@m"
template="name=C1
w=1u
l=1u
m=1
model=cmom_m4m7
spiceprefix=X
"
}
V {}
S {}
F {}
E {}
L 4 0 5 0 30 {}
L 4 0 -30 0 -5 {}
L 4 -10 -5 10 -5 {}
L 4 -10 5 10 5 {}
B 5 -2.5 -32.5 2.5 -27.5 {name=P dir=inout}
B 5 -2.5 27.5 2.5 32.5 {name=N dir=inout}
T {@name} 15 -26.25 0 0 0.2 0.2 {}
T {@model} 15 -13.75 0 0 0.2 0.2 {}
T {w=@w} 15 -1.25 0 0 0.2 0.2 {layer=13}
T {l=@l} 15 11.25 0 0 0.2 0.2 {layer=13}
T {m=@m} 15 23.75 0 0 0.2 0.2 {layer=13}
