*
* TiN thin-film resistor, l is the length between the two M1 contacts.
* B is the substrate under the film, mm=1 adds mismatch.
* An IIC-OSIC-TOOLS addition with assumed parameters, ASAP7 defines no
* passive devices.
}
G {}
K {type=resistor
format="@spiceprefix@name @pinlist @model w=@w l=@l m=@m mm=@mm"
lvs_format="@spiceprefix@name @pinlist @model w=@w l=@l m=@m mm=@mm"
spectre_format="@spiceprefix@name ( @pinlist ) @model w=@w l=@l m=@m mm=@mm"
template="name=R1
w=108n
l=1u
m=1
mm=0
model=rtfr
spiceprefix=X
"
}
V {}
S {}
F {}
E {}
L 4 0 20 0 30 {}
L 4 0 20 7.5 17.5 {}
