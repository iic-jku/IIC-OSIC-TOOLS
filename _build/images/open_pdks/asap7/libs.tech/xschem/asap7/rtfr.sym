L 4 0 -30 0 -20 {}
B 5 -2.5 -32.5 2.5 -27.5 {name=P dir=inout}
B 5 -2.5 27.5 2.5 32.5 {name=N dir=inout}
B 5 -22.5 -2.5 -17.5 2.5 {name=B dir=inout}
L 4 -20 0 -12.5 0 {}
L 4 -12.5 -17.5 -12.5 17.5 {}
