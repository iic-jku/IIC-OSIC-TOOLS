}
G {}
K {type=capacitor
format="@spiceprefix@name @@B @@G @@B @@B @model l=@l nfin=@nfin m=@m"
lvs_format="@spiceprefix@name @@B @@G @@B @@B @model l=@l nfin=@nfin m=@m"
spectre_format="@spiceprefix@name ( @@B @@G @@B @@B ) @model l=@l nfin=@nfin m=@m"
template="name=C1
l=20n
nfin=4
m=1
model=nmos_lvt
spiceprefix=X
"
}
V {}
S {}
F {}
E {}
L 4 0 5 0 30 {}
L 4 0 -30 0 -10 {}
L 4 -12.5 -10 12.5 -10 {}
L 4 -12.5 5 12.5 5 {}
L 4 -12.5 -5 12.5 -5 {}
L 4 -12.5 -5 -12.5 5 {}
L 4 12.5 -5 12.5 5 {}
B 5 -2.5 -32.5 2.5 -27.5 {name=G dir=inout}
B 5 -2.5 27.5 2.5 32.5 {name=B dir=inout}
T {@name} 17.5 -26.25 0 0 0.2 0.2 {}
T {@model} 17.5 -13.75 0 0 0.2 0.2 {}
T {nfin=@nfin} 17.5 -1.25 0 0 0.2 0.2 {layer=13}
T {l=@l} 17.5 11.25 0 0 0.2 0.2 {layer=13}
T {m=@m} 17.5 23.75 0 0 0.2 0.2 {layer=13}
T {G} -10 -25 0 1 0.15 0.15 {layer=7}
T {B} -10 15 0 1 0.15 0.15 {layer=7}
