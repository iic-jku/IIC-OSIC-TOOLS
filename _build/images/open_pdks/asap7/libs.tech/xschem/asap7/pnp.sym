* Vertical PNP: emitter p+ active in the well, base the well, collector the
* substrate. m strips of nfin fins. An IIC-OSIC-TOOLS addition with assumed
* parameters, ASAP7 has no bipolar transistor.
}
G {}
K {type=pnp
format="@spiceprefix@name @@C @@B @@E @model nfin=@nfin m=@m"
lvs_format="@spiceprefix@name @@C @@B @@E @model nfin=@nfin m=@m"
spectre_format="@spiceprefix@name ( @@C @@B @@E ) @model nfin=@nfin m=@m"
template="name=Q1
nfin=4
m=1
model=pnp
spiceprefix=X
"
}
